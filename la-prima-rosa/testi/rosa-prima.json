[{"t": 3.51, "s": "Intro"}, {"t": 3.51, "e": 11.73, "l": "In corde uno, duae voces,"}, {"t": 11.73, "e": 18.27, "l": "una vocabat, altera tacebat."}, {"t": 18.27, "e": 25.93, "l": "Duo desideria, una anima,"}, {"t": 25.93, "e": 30.24, "l": "neutrum alteri cedebat."}, {"t": 30.24, "s": "Verse I"}, {"t": 30.24, "e": 33.91, "l": "Rosa sub luce brevi floruit,"}, {"t": 33.91, "e": 39.81, "l": "Rosa sub luce brevi floruit,"}, {"t": 39.81, "e": 46.44, "l": "duobus ventis agitata."}, {"t": 46.44, "e": 52.74, "l": "Radices eam in terra tenebant,"}, {"t": 52.74, "e": 58.96, "l": "rami caelum desiderabant."}, {"t": 58.96, "e": 62.79, "l": "Et cum vesper advenisset,"}, {"t": 62.79, "e": 69.02, "l": "nondum pax inter radices ramosque erat."}, {"t": 69.02, "e": 73.32, "l": "Quod cor dividit,"}, {"t": 73.32, "e": 81.62, "l": "tempus non semper solvit."}, {"t": 81.62, "s": "Verse II"}, {"t": 81.62, "e": 88.64, "l": "Longinqua terra, silentium longum,"}, {"t": 88.64, "e": 94.07, "l": "manus absens, vox non audita."}, {"t": 94.07, "e": 99.34, "l": "Et nomen rediit in alio flore,"}, {"t": 99.34, "e": 104.84, "l": "sed flos non erat rosa prima."}, {"t": 104.84, "e": 110.5, "l": "Idem nomen, altera vita,"}, {"t": 110.5, "e": 118.25, "l": "eadem memoria, alia forma."}, {"t": 118.25, "s": "Verse III"}, {"t": 118.25, "e": 122.87, "l": "Et ut vox in octavam surgens,"}, {"t": 122.87, "e": 128.78, "l": "rursus apparuit, altior, matris vultus."}, {"t": 128.78, "e": 133.4, "l": "Domus immensa, mille portae,"}, {"t": 133.4, "e": 137.79, "l": "mille filii, una crux."}, {"t": 137.79, "e": 142.42, "l": "Qui pater omnium factus erat,"}, {"t": 142.42, "e": 146.97, "l": "in corde filius permanebat."}, {"t": 146.97, "e": 151.12, "l": "Et quaesivit inter columnas"}, {"t": 151.12, "e": 158.3, "l": "manum quam tempus abstulerat."}, {"t": 158.3, "s": "Pre-Chorus"}, {"t": 158.3, "e": 160.53, "l": "Mater in carne,"}, {"t": 160.53, "e": 162.61, "l": "mater in nomine,"}, {"t": 162.61, "e": 166.36, "l": "mater vigilans in templo."}, {"t": 166.36, "e": 167.95, "l": "Tres vultus,"}, {"t": 167.95, "e": 170.11, "l": "unus amor."}, {"t": 170.11, "e": 174.34, "l": "Quaeque mater dat quod habet,"}, {"t": 174.34, "e": 181.04, "l": "nulla alterius locum tenet."}, {"t": 181.04, "s": "Bridge"}, {"t": 181.04, "e": 188.94, "l": "Quod cor dividit, tempore non moritur,"}, {"t": 188.94, "e": 196.12, "l": "in alia forma redit, alio tempore."}, {"t": 196.12, "e": 200.27, "l": "Bis vita, ter vocatio,"}, {"t": 200.27, "e": 206.57, "l": "unum nomen, una domus, amor longinquus."}, {"t": 206.57, "e": 210.48, "l": "Quod gremium dedit non perit,"}, {"t": 210.48, "e": 219.25, "l": "et quod amissum est, Deo committi potest."}, {"t": 219.25, "s": "Chorus"}, {"t": 219.25, "e": 223.48, "l": "Non regressus, sed memoria."}, {"t": 223.48, "e": 227.63, "l": "Non vacuum, sed fiducia."}, {"t": 227.63, "e": 231.7, "l": "Non in loco eius, sed iuxta."}, {"t": 231.7, "e": 235.29, "l": "Non possessio, sed amor."}, {"t": 235.29, "e": 239.12, "l": "Quod quaeris non est perditum,"}, {"t": 239.12, "e": 242.39, "l": "quod amas vivit in Deo."}, {"t": 242.39, "e": 246.22, "l": "Una mater, memoria aeterna,"}, {"t": 246.22, "e": 256.22, "l": "et Ecclesia, mater et ipsa."}, {"t": 264.81, "s": "Final Verse"}, {"t": 264.81, "e": 270.16, "l": "Et via antiqua iterum ducebat"}, {"t": 270.16, "e": 275.75, "l": "ad terram ubi silentium manebat."}, {"t": 275.75, "e": 279.57, "l": "Sed non idem erat viator,"}, {"t": 279.57, "e": 284.28, "l": "nec idem erat desiderium."}, {"t": 284.28, "e": 288.19, "l": "Non omnia quae perdimus"}, {"t": 288.19, "e": 292.5, "l": "in alia forma redeunt."}, {"t": 292.5, "e": 296.73, "l": "Sed omnia quae amavimus"}, {"t": 296.73, "e": 302.07, "l": "in Deo custodiuntur."}, {"t": 302.07, "s": "Outro"}, {"t": 302.07, "e": 307.5, "l": "Mater, mane in amore."}, {"t": 307.5, "e": 312.53, "l": "Ecclesia, mane in veritate."}, {"t": 312.53, "e": 315.24, "l": "Quod fuit, fuit."}, {"t": 315.24, "e": 318.03, "l": "Quod est, sit."}, {"t": 318.03, "s": "Long silence"}, {"t": 318.03, "e": 322.82, "l": "Mater…"}, {"t": 322.82, "e": 324.1, "l": "et pax."}, {"t": 324.1, "e": 334.1, "l": "Amen."}]