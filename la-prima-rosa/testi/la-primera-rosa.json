[{"t": 10.05, "s": "Intro"}, {"t": 10.05, "e": 16.91, "l": "En un solo corazón, dos voces,"}, {"t": 16.91, "e": 24.5, "l": "una llamaba, la otra callaba."}, {"t": 24.5, "e": 32.55, "l": "Dos deseos, una sola alma,"}, {"t": 32.55, "e": 42.55, "l": "ninguno cedía ante el otro."}, {"t": 44.84, "s": "Verso I"}, {"t": 44.84, "e": 52.1, "l": "Una rosa floreció bajo una luz breve,"}, {"t": 52.1, "e": 58.32, "l": "sacudida por dos vientos."}, {"t": 58.32, "e": 64.39, "l": "Sus raíces la sostenían en la tierra,"}, {"t": 64.39, "e": 70.77, "l": "sus ramas deseaban el cielo."}, {"t": 70.77, "e": 76.68, "l": "Y cuando llegó la tarde,"}, {"t": 76.68, "e": 83.38, "l": "aún no había paz entre raíces y ramas."}, {"t": 83.38, "e": 87.93, "l": "Lo que divide el corazón,"}, {"t": 87.93, "e": 97.93, "l": "el tiempo no siempre lo resuelve."}, {"t": 105.56, "s": "Verso II"}, {"t": 105.56, "e": 111.54, "l": "Tierra lejana, largo silencio,"}, {"t": 111.54, "e": 117.53, "l": "mano ausente, voz no escuchada."}, {"t": 117.53, "e": 122.39, "l": "Y el nombre volvió en otra flor,"}, {"t": 122.39, "e": 128.14, "l": "pero aquella flor no era la primera rosa."}, {"t": 128.14, "e": 132.61, "l": "El mismo nombre, otra vida,"}, {"t": 132.61, "e": 141.86, "l": "la misma memoria, otra forma."}, {"t": 141.86, "s": "Verso III"}, {"t": 141.86, "e": 147.61, "l": "Y como una nota llevada a la octava,"}, {"t": 147.61, "e": 153.75, "l": "reapareció, más alto, el rostro de una madre."}, {"t": 153.75, "e": 157.02, "l": "Casa inmensa, mil puertas,"}, {"t": 157.02, "e": 160.77, "l": "mil hijos, una sola cruz."}, {"t": 160.77, "e": 166.12, "l": "Quien se había convertido en padre de todos,"}, {"t": 166.12, "e": 170.9, "l": "en el corazón seguía siendo hijo."}, {"t": 170.9, "e": 175.29, "l": "Y buscó entre las columnas"}, {"t": 175.29, "e": 183.19, "l": "la mano que el tiempo le había arrebatado."}, {"t": 183.19, "s": "Pre-estribillo"}, {"t": 183.19, "e": 187.02, "l": "Madre en la carne,"}, {"t": 187.02, "e": 191.01, "l": "madre en el nombre,"}, {"t": 191.01, "e": 196.84, "l": "madre que vela en el templo."}, {"t": 196.84, "e": 200.35, "l": "Tres rostros,"}, {"t": 200.35, "e": 202.18, "l": "un solo amor."}, {"t": 202.18, "e": 206.17, "l": "Cada madre da lo que tiene,"}, {"t": 206.17, "e": 216.17, "l": "ninguna ocupa el lugar de otra."}, {"t": 220.85, "s": "Puente"}, {"t": 220.85, "e": 228.11, "l": "Lo que divide el corazón no muere con el tiempo,"}, {"t": 228.11, "e": 233.62, "l": "vuelve bajo otra forma, en otro momento."}, {"t": 233.62, "e": 240.8, "l": "Dos veces la vida, tres veces la llamada,"}, {"t": 240.8, "e": 247.42, "l": "un nombre, una casa, un amor lejano."}, {"t": 247.42, "e": 251.73, "l": "Lo que el seno ha dado no se pierde,"}, {"t": 251.73, "e": 261.3, "l": "y lo que se ha perdido se puede encomendar."}, {"t": 261.3, "s": "Estribillo"}, {"t": 261.3, "e": 269.36, "l": "No regreso, sino memoria."}, {"t": 269.36, "e": 277.66, "l": "No un vacío, sino confianza."}, {"t": 277.66, "e": 281.73, "l": "No en su lugar, sino a su lado."}, {"t": 281.73, "e": 285.72, "l": "No posesión, sino amor."}, {"t": 285.72, "e": 290.27, "l": "Lo que buscas no está perdido,"}, {"t": 290.27, "e": 294.18, "l": "lo que amas vive en Dios."}, {"t": 294.18, "e": 298.25, "l": "Una sola madre, memoria eterna,"}, {"t": 298.25, "e": 307.66, "l": "y la Iglesia, madre también."}, {"t": 307.66, "s": "Verso final"}, {"t": 307.66, "e": 312.77, "l": "Y el antiguo camino conducía de nuevo"}, {"t": 312.77, "e": 318.19, "l": "a la tierra donde permanecía el silencio."}, {"t": 318.19, "e": 321.86, "l": "Pero no era el mismo viajero,"}, {"t": 321.86, "e": 325.69, "l": "ni era el mismo deseo."}, {"t": 325.69, "e": 329.84, "l": "No todo lo que perdemos"}, {"t": 329.84, "e": 333.67, "l": "regresa bajo otra forma."}, {"t": 333.67, "e": 338.06, "l": "Pero todo lo que hemos amado"}, {"t": 338.06, "e": 343.08, "l": "queda guardado en Dios."}, {"t": 343.08, "s": "Final"}, {"t": 343.08, "e": 349.55, "l": "Madre, permanece en el amor."}, {"t": 349.55, "e": 357.93, "l": "Iglesia, permanece en la verdad."}, {"t": 357.93, "e": 361.44, "l": "Lo que fue, fue."}, {"t": 361.44, "e": 366.94, "l": "Lo que es, sea."}, {"t": 366.94, "s": "Silencio prolongado"}, {"t": 366.94, "e": 373.72, "l": "Madre…"}, {"t": 373.72, "e": 376.52, "l": "y paz."}, {"t": 376.52, "e": 381.23, "l": "Amén."}]